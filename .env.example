# Copy this file to .env.local and fill in your own values.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — leave blank to use the built-in rule-based report instead of the LLM.
# Anthropic Console -> API Keys
ANTHROPIC_API_KEY=

# Required for email deadline reminders — see README "Email reminders setup".
# Use a Gmail "App Password", NOT your normal Gmail password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=
